# Copy to whatsapp-worker/.env on the VPS (never commit the real file — it sits next to your
# WhatsApp session credentials).

# Same Supabase project as the main app (.env.oracle.example) — service role only, this process
# never runs in a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local-only HTTP API the Next.js app calls (WHATSAPP_WORKER_URL / WHATSAPP_WORKER_SECRET in the
# main app's env must match this port + secret). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_WORKER_PORT=4310
WHATSAPP_WORKER_SECRET=replace-with-a-long-random-secret

# Where useMultiFileAuthState persists the linked-device session. Must survive restarts/deploys —
# point this at a path on a real disk (or a mounted volume if this ever runs in a container), not
# somewhere that gets wiped on redeploy, or you'll have to re-scan the QR every time.
WHATSAPP_AUTH_DIR=./auth_info_baileys

# Where the Next.js app is reachable from this VPS — used for the JazzCash SMS auto-verify
# cross-match (POST /api/payments/jazzcash/verify) AND the AI auto-reply (POST /api/whatsapp/
# ai-reply). If the app runs in a Docker container (e.g. Coolify) that isn't reachable via
# localhost from this process, use its public HTTPS domain instead. Leave blank to disable both —
# the worker still logs incoming messages either way, it just won't reply.
WHATSAPP_APP_BASE_URL=https://your-domain.example

# silent | error | warn | info | debug | trace — Baileys is very chatty above "warn".
WHATSAPP_LOG_LEVEL=warn
