# Copy to whatsapp-worker/.env on the VPS (never commit the real file — it sits next to your
# WhatsApp session credentials).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

WHATSAPP_WORKER_PORT=4310
WHATSAPP_WORKER_SECRET=replace-with-a-long-random-secret
WHATSAPP_AUTH_DIR=./auth_info_baileys
WHATSAPP_APP_BASE_URL=https://your-domain.example
WHATSAPP_LOG_LEVEL=warn

# Server-only CEO number. Incoming photos/screenshots/files are forwarded here silently,
# and repeated requests to speak to the CEO are escalated here. Accepts 03... or 92... format.
WHATSAPP_CEO_NUMBER=03480049900
