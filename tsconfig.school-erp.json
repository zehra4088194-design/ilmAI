{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "next-env.d.ts",
    "src/lib/school-erp/**/*.ts",
    "src/components/features/school-erp/**/*.tsx",
    "src/app/school/**/*.ts",
    "src/app/school/**/*.tsx",
    "src/app/school-admin/**/*.ts",
    "src/app/school-admin/**/*.tsx",
    "src/app/schools/**/*.ts",
    "src/app/schools/**/*.tsx",
