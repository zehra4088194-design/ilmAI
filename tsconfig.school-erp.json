    "src/app/(admin)/admin/schools/**/*.tsx",
    "src/components/layout/AdminSidebar/index.tsx",
    "src/components/layout/DashboardSidebar/index.tsx",
    "src/lib/rate-limit/index.ts",
    "src/lib/branding/**/*.ts",
    "src/app/(dashboard)/layout.tsx",
