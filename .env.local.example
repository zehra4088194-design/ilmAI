# ============================================
# ilm AI - LOCAL NEXT.JS ENVIRONMENT
# ============================================
# Raw AI provider keys do not belong here. They live only in the private
# AI gateway service. Production values are configured in the deployment host.

# --- MANAGED SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- PRIVATE SERVICES ---
AI_GATEWAY_URL=http://localhost:8787
AI_GATEWAY_SECRET=paste_the_same_long_random_string_used_by_the_ai_gateway
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_SECRET=paste_a_different_long_random_string_used_by_the_ocr_service
REDIS_URL=redis://:your-password@localhost:6379/0

# --- ILMAI.STORE ACCOUNT HANDOFF ---
# Same value must be set on ilmai.store's own deployment (STORE_HANDOFF_SECRET
# there) — signs the short-lived token /api/store-handoff mints so a logged-in
# user lands on the store already signed into their linked account instead of
# having to sign up separately. See src/lib/store-handoff.ts.
STORE_HANDOFF_SECRET=
STORE_URL=https://ilmai.store

# "Order printed notes" button on a library resource — same value must be set on ilmai.store as
# NOTES_PRODUCT_SYNC_SECRET. Guards POST <STORE_URL>/api/internal/notes-product, which
# creates/updates the matching store product. See src/lib/library/notesProductSync.ts.
NOTES_PRODUCT_SYNC_SECRET=

# --- PAYMENTS (OPTIONAL UNTIL MERCHANT APPROVAL) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Every PRO/ELITE plan (student, and the parent/teacher/university families) checks out through
# Paddle's non-catalog price API: one PRODUCT id each below (pro_..., NOT a price id), with the
# actual charge amount set fresh per checkout from whatever the admin panel currently has saved
# (see resolvePlanAmountUsd in lib/platform-settings/shared.ts and resolveCheckoutPricing in
# lib/payments/paddle.ts). Change a plan's price in the admin panel and it applies immediately —
# no matching Paddle dashboard price to create or update.
PADDLE_PRODUCT_ID_STUDENT_PRO=
PADDLE_PRODUCT_ID_STUDENT_ELITE=
PADDLE_PRODUCT_ID_PARENT_PRO=
PADDLE_PRODUCT_ID_PARENT_ELITE=
PADDLE_PRODUCT_ID_TEACHER_PRO=
PADDLE_PRODUCT_ID_TEACHER_ELITE=
PADDLE_PRODUCT_ID_UNIVERSITY_PRO=
PADDLE_PRODUCT_ID_UNIVERSITY_ELITE=
# Same pattern for the school/college "pay now with card" button and the footer/dashboard
# "Support us" donate widget — each just needs one product id too.
PADDLE_INSTITUTION_PRODUCT_ID=
PADDLE_SUPPORT_PRODUCT_ID=

# --- ADMIN ---
ADMIN_EMAILS=you@example.com

# --- INSTITUTION MANUAL PAYMENTS (school/college plan checkout) ---
# Shown on the checkout QR/number card and read client-side, so these are
# intentionally NEXT_PUBLIC_* (a checkout screen is public-facing by nature).
NEXT_PUBLIC_SCHOOL_PAYMENT_JAZZCASH_NUMBER=03001088194
NEXT_PUBLIC_SCHOOL_PAYMENT_EASYPAISA_NUMBER=03001088194
NEXT_PUBLIC_SCHOOL_PAYMENT_BANK_DETAILS=Bank Name, Account Title, Account Number, IBAN

# --- SUPPORT / SUGGESTIONS / PAYMENT PROOF (server-only — deliberately NOT NEXT_PUBLIC_*) ---
# Every one of these is a plain inbox address the corresponding form sends to server-side via
# Brevo (src/lib/email/send.ts) — the address itself never appears in client-bundled JS/HTML.
# These go straight to the real inbox (not the public information@/support@/suggestions@
# ilmai.study addresses, which are for users who want to email us directly). Fall back to
# ilmai.study1@gmail.com if unset.
# /api/contact (public "Contact us" form)
CONTACT_EMAIL=ilmai.study1@gmail.com
# /api/resource-feedback (mistake/suggestion reports under a PDF resource)
MISTAKE_REPORT_EMAIL=ilmai.study1@gmail.com
# /api/suggestions (the Support dialog's "have a suggestion?" box, with optional screenshot)
SUGGESTION_EMAIL=ilmai.study1@gmail.com
# /api/payments/confirm-proof (manual JazzCash/Easypaisa payment screenshot + sender name/number)
PAYMENT_PROOF_EMAIL=ilmai.study1@gmail.com

# --- HOUSE ADS (self-served banners promoting ilmai.store) ---
# Bearer secret ilmai.store's server sends on POST /api/ads/conversion callbacks.
# This exact value must also be set in ilmai.store's own environment.
AD_TRACKING_SECRET=replace-with-a-long-random-secret

# --- APP CONFIG ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ilm AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- EMAIL + WHATSAPP (BREVO) ---
# Free account at https://app.brevo.com — replaces the old SMTP transport for every outgoing email
# (auth OTPs, school/college notifications, report cards) and adds real WhatsApp delivery for
# weekly parent reports, fee reminders, and leave-decision updates. See src/lib/email/send.ts and
# src/lib/whatsapp/brevo.ts.
BREVO_API_KEY=
EMAIL_FROM=ilm AI <noreply@your-domain.example>
CONTACT_EMAIL=ilmai.study1@gmail.com
# Server-only — where "report a mistake / suggestion" on a resource is sent (via Brevo, from
# the server, never the browser). See src/app/api/resource-feedback.
MISTAKE_REPORT_EMAIL=ilmai.study1@gmail.com
# WhatsApp: needs a Business sender number connected under Brevo > WhatsApp > Senders (Meta must
# approve it), digits only with country code, e.g. 923001234567.
BREVO_WHATSAPP_SENDER=
# One approved Brevo/Meta WhatsApp template per notification kind — create each under
# Brevo > WhatsApp > Templates with two body variables ({{1}} = title, {{2}} = message), then paste
# the template's id here. Leave blank to skip WhatsApp for that kind (email/in-app/push still send).
BREVO_WHATSAPP_TEMPLATE_FEE_REMINDER=
BREVO_WHATSAPP_TEMPLATE_ABSENCE_ALERT=
BREVO_WHATSAPP_TEMPLATE_WEEKLY_REPORT=
BREVO_WHATSAPP_TEMPLATE_LEAVE_UPDATE=
BREVO_WHATSAPP_TEMPLATE_ANNOUNCEMENT=
# Optional plain-SMS fallback (separate from WhatsApp) — a generic webhook to your own SMS gateway.
SCHOOL_SMS_WEBHOOK_URL=
SCHOOL_SMS_WEBHOOK_TOKEN=
COLLEGE_SMS_WEBHOOK_URL=
COLLEGE_SMS_WEBHOOK_TOKEN=

# --- GOOGLE RECAPTCHA V3 ---
# The site key is public and bundled into the browser. Keep the secret server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- LIVEKIT (Quran Class live calling) ---
# Free account at https://livekit.io â€” used for the teacher-video/student-audio group calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional S3-compatible object storage. Use Backblaze B2, Cloudflare R2, or another S3-compatible provider.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=ilm-ai-assets
OBJECT_STORAGE_FORCE_PATH_STYLE=

# Separate B2 account/bucket used ONLY for University Hub notes (books, past papers,
# topic-wise notes, etc uploaded per degree program). Falls back to OBJECT_STORAGE_ENDPOINT
# if left blank, but needs its own access key — a B2 application key only grants access to
# buckets in its own account.
UNIVERSITY_STORAGE_ENDPOINT=
UNIVERSITY_STORAGE_REGION=auto
UNIVERSITY_STORAGE_ACCESS_KEY_ID=
UNIVERSITY_STORAGE_SECRET_ACCESS_KEY=
UNIVERSITY_STORAGE_BUCKET=ilmai-uni-bucket
UNIVERSITY_STORAGE_FORCE_PATH_STYLE=

# Separate B2 account/bucket for chat attachments (Study Buddies, parent<->student, parent<->
# teacher/principal) — keep this bucket PRIVATE (not public); every read goes through a signed
# URL, never a public bucket URL. Falls back to OBJECT_STORAGE_ENDPOINT if left blank, but needs
# its own access key, same reasoning as the other dedicated buckets above.
CHAT_STORAGE_ENDPOINT=
CHAT_STORAGE_REGION=auto
CHAT_STORAGE_ACCESS_KEY_ID=
CHAT_STORAGE_SECRET_ACCESS_KEY=
CHAT_STORAGE_BUCKET=
CHAT_STORAGE_FORCE_PATH_STYLE=

# --- CRON ---
CRON_SECRET=replace_with_a_long_random_string
# USD/PKR rate refresh (api/cron/usd-pkr-rate). Get a free key at https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# --- GOOGLE PLAY / TRUSTED WEB ACTIVITY ---
ANDROID_PACKAGE_NAME=study.ilm.app
ANDROID_SHA256_CERT_FINGERPRINTS=
PLAY_CONSUMPTION_ONLY_HOSTS=

# --- PRICING (Optional: defaults set in admin panel, override here if needed) ---

# Parent Plans
NEXT_PUBLIC_PARENT_PLAN_FREE_CHILDREN=1
NEXT_PUBLIC_PARENT_PLAN_PAID_PRICE_USD=1.99
NEXT_PUBLIC_PARENT_PLAN_PAID_CHILDREN=4
NEXT_PUBLIC_PARENT_PLAN_ELITE_PRICE_USD=3.49
NEXT_PUBLIC_PARENT_PLAN_ELITE_CHILDREN=null

# University Student Plans
NEXT_PUBLIC_UNIVERSITY_PLAN_FREE_PRICE_USD=0
NEXT_PUBLIC_UNIVERSITY_PLAN_FREE_CREDITS=20
NEXT_PUBLIC_UNIVERSITY_PLAN_PAID_PRICE_USD=4.99
NEXT_PUBLIC_UNIVERSITY_PLAN_PAID_CREDITS=200
NEXT_PUBLIC_UNIVERSITY_PLAN_ELITE_PRICE_USD=9.99
NEXT_PUBLIC_UNIVERSITY_PLAN_ELITE_CREDITS=1000

# Teacher Plans
NEXT_PUBLIC_TEACHER_PLAN_FREE_PRICE_USD=0
NEXT_PUBLIC_TEACHER_PLAN_FREE_CLASSROOMS=1
NEXT_PUBLIC_TEACHER_PLAN_PAID_PRICE_USD=2.99
NEXT_PUBLIC_TEACHER_PLAN_PAID_CLASSROOMS=5
NEXT_PUBLIC_TEACHER_PLAN_ELITE_PRICE_USD=6.99
NEXT_PUBLIC_TEACHER_PLAN_ELITE_CLASSROOMS=null

# Institution Plans (School/College)
NEXT_PUBLIC_SCHOOL_BASE_PRICE_USD=10
NEXT_PUBLIC_COLLEGE_BASE_PRICE_USD=20
NEXT_PUBLIC_INSTITUTION_ANNUAL_DISCOUNT_PERCENT=15
NEXT_PUBLIC_INSTITUTION_VOLUME_DISCOUNT_PERCENT=10
NEXT_PUBLIC_INSTITUTION_VOLUME_MIN_STUDENTS=500

