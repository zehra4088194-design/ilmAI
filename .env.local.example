# ============================================
# ilm AI - LOCAL NEXT.JS ENVIRONMENT
# ============================================
# Raw AI provider keys do not belong here. They live only in the private
# AI gateway service. Production values are configured in the deployment host.

# --- MANAGED SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- PRIVATE SERVICES ---
AI_GATEWAY_URL=http://localhost:8787
AI_GATEWAY_SECRET=paste_the_same_long_random_string_used_by_the_ai_gateway
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_SECRET=paste_a_different_long_random_string_used_by_the_ocr_service
REDIS_URL=redis://:your-password@localhost:6379/0

# --- ILMAI.STORE ACCOUNT HANDOFF ---
# Same value must be set on ilmai.store's own deployment (STORE_HANDOFF_SECRET
# there) — signs the short-lived token /api/store-handoff mints so a logged-in
# user lands on the store already signed into their linked account instead of
# having to sign up separately. See src/lib/store-handoff.ts.
STORE_HANDOFF_SECRET=
STORE_URL=https://ilmai.store

# --- PAYMENTS (OPTIONAL UNTIL MERCHANT APPROVAL) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_PRICE_ID_ELITE_MONTHLY=
PADDLE_PRICE_ID_ELITE_ANNUAL=
PADDLE_PRICE_ID_INSTITUTIONAL_PRO_MONTHLY=
PADDLE_PRICE_ID_INSTITUTIONAL_PRO_ANNUAL=
PADDLE_PRICE_ID_INSTITUTIONAL_ELITE_MONTHLY=
PADDLE_PRICE_ID_INSTITUTIONAL_ELITE_ANNUAL=

# --- ADMIN ---
ADMIN_EMAILS=you@example.com

# --- INSTITUTION MANUAL PAYMENTS (school/college plan checkout) ---
# Shown on the checkout QR/number card and read client-side, so these are
# intentionally NEXT_PUBLIC_* (a checkout screen is public-facing by nature).
NEXT_PUBLIC_SCHOOL_PAYMENT_JAZZCASH_NUMBER=03006596490
NEXT_PUBLIC_SCHOOL_PAYMENT_EASYPAISA_NUMBER=03480049900
NEXT_PUBLIC_SCHOOL_PAYMENT_BANK_DETAILS=Bank Name, Account Title, Account Number, IBAN
NEXT_PUBLIC_SCHOOL_PAYMENT_WHATSAPP_NUMBER=923480049900

# --- HOUSE ADS (self-served banners promoting ilmai.store) ---
# Bearer secret ilmai.store's server sends on POST /api/ads/conversion callbacks.
# This exact value must also be set in ilmai.store's own environment.
AD_TRACKING_SECRET=replace-with-a-long-random-secret

# --- APP CONFIG ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ilm AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- EMAIL SMTP ---
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=ilm AI <noreply@your-domain.example>
CONTACT_EMAIL=ilmai.study1@gmail.com

# --- GOOGLE RECAPTCHA V3 ---
# The site key is public and bundled into the browser. Keep the secret server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- LIVEKIT (Quran Class live calling) ---
# Free account at https://livekit.io â€” used for the teacher-video/student-audio group calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional S3-compatible object storage. Use Backblaze B2, Cloudflare R2, or another S3-compatible provider.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=ilm-ai-assets
OBJECT_STORAGE_FORCE_PATH_STYLE=

# --- CRON ---
CRON_SECRET=replace_with_a_long_random_string
# USD/PKR rate refresh (api/cron/usd-pkr-rate). Get a free key at https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# --- GOOGLE PLAY / TRUSTED WEB ACTIVITY ---
ANDROID_PACKAGE_NAME=study.ilm.app
ANDROID_SHA256_CERT_FINGERPRINTS=
PLAY_CONSUMPTION_ONLY_HOSTS=

# --- PRICING (Optional: defaults set in admin panel, override here if needed) ---

# Parent Plans
NEXT_PUBLIC_PARENT_PLAN_FREE_CHILDREN=1
NEXT_PUBLIC_PARENT_PLAN_PAID_PRICE_USD=1.99
NEXT_PUBLIC_PARENT_PLAN_PAID_CHILDREN=4
NEXT_PUBLIC_PARENT_PLAN_ELITE_PRICE_USD=3.49
NEXT_PUBLIC_PARENT_PLAN_ELITE_CHILDREN=null

# University Student Plans
NEXT_PUBLIC_UNIVERSITY_PLAN_FREE_PRICE_USD=0
NEXT_PUBLIC_UNIVERSITY_PLAN_FREE_CREDITS=20
NEXT_PUBLIC_UNIVERSITY_PLAN_PAID_PRICE_USD=4.99
NEXT_PUBLIC_UNIVERSITY_PLAN_PAID_CREDITS=200
NEXT_PUBLIC_UNIVERSITY_PLAN_ELITE_PRICE_USD=9.99
NEXT_PUBLIC_UNIVERSITY_PLAN_ELITE_CREDITS=1000

# Teacher Plans
NEXT_PUBLIC_TEACHER_PLAN_FREE_PRICE_USD=0
NEXT_PUBLIC_TEACHER_PLAN_FREE_CLASSROOMS=1
NEXT_PUBLIC_TEACHER_PLAN_PAID_PRICE_USD=2.99
NEXT_PUBLIC_TEACHER_PLAN_PAID_CLASSROOMS=5
NEXT_PUBLIC_TEACHER_PLAN_ELITE_PRICE_USD=6.99
NEXT_PUBLIC_TEACHER_PLAN_ELITE_CLASSROOMS=null

# Institution Plans (School/College)
NEXT_PUBLIC_SCHOOL_BASE_PRICE_USD=10
NEXT_PUBLIC_COLLEGE_BASE_PRICE_USD=20
NEXT_PUBLIC_INSTITUTION_ANNUAL_DISCOUNT_PERCENT=15
NEXT_PUBLIC_INSTITUTION_VOLUME_DISCOUNT_PERCENT=10
NEXT_PUBLIC_INSTITUTION_VOLUME_MIN_STUDENTS=500

