# Copy values into Coolify's Environment Variables screen. Do not commit real secrets.

# Public app/domain. HTTPS is required for camera, PWA installation, and Play Store TWA.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_APP_NAME=ilm AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# Existing managed Supabase project. Keep Service Role server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Generate independent random alphanumeric values, at least 32 characters each.
AI_GATEWAY_SECRET=replace-with-a-long-random-secret
OCR_SERVICE_SECRET=replace-with-a-different-long-random-secret
VALKEY_PASSWORD=replace-with-a-long-url-safe-password
CRON_SECRET=replace-with-a-different-long-random-secret
# USD/PKR rate refresh (api/cron/usd-pkr-rate). Get a free key at https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=
ADMIN_EMAILS=you@example.com

# Institution manual payments (school/college plan checkout) — public by nature.
NEXT_PUBLIC_SCHOOL_PAYMENT_JAZZCASH_NUMBER=03006596490
NEXT_PUBLIC_SCHOOL_PAYMENT_EASYPAISA_NUMBER=03480049900
NEXT_PUBLIC_SCHOOL_PAYMENT_BANK_DETAILS=Bank Name, Account Title, Account Number, IBAN
NEXT_PUBLIC_SCHOOL_PAYMENT_WHATSAPP_NUMBER=923480049900

# Google reCAPTCHA v3. The site key is public; never expose the secret key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Existing analytics plus optional monitoring. All can remain empty initially.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production

# Optional Firebase Cloud Messaging. Oracle requires the base64 service account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional S3-compatible object storage for PDFs/TXT, parent archives, and media cache.
# Backblaze B2 example endpoint: https://s3.us-west-004.backblazeb2.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=ilm-ai-assets
OBJECT_STORAGE_FORCE_PATH_STYLE=

# Legacy Cloudflare R2 names are still supported.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ilm-ai-assets

# Optional Algolia public catalog search.
ALGOLIA_ENABLED=false
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX_NAME=ilm_ai_public_catalog

# Provider pools stay only inside Coolify's private AI gateway container.
# Local TXT-grounded AI. The GGUF model is downloaded once into a persistent
# Docker volume and is never exposed publicly.
LLAMA_CPP_HF_REPO=Qwen/Qwen3-4B-GGUF:Q4_K_M
LLAMA_CPP_MODEL=qwen3-4b-q4
LLAMA_CPP_CONTEXT_SIZE=16384
LLAMA_CPP_THREADS=3
LLAMA_CPP_TIMEOUT_MS=180000

GROQ_API_KEYS_JSON=[]
GROQ_API_KEY=
GROK_API_KEYS_JSON=[]
GROK_API_KEY=
CLAUDE_API_KEYS_JSON=[]
CLAUDE_API_KEY=
GPT_API_KEYS_JSON=[]
GPT_API_KEY=
GEMINI_API_KEYS_JSON=[]
GEMINI_API_KEY=
DEEPSEEK_API_KEYS_JSON=[]
DEEPSEEK_API_KEY=
OCRSPACE_API_KEYS_JSON=[]
OCRSPACE_API_KEY=
# One OpenRouter key only. It serves openrouter/free first and retries on
# deepseek/deepseek-v4-flash only when that call fails.
OPENROUTER_API_KEY=
DEEPSEEK_MINI_MODEL=deepseek-v4-flash
DEEPSEEK_MEDIUM_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-flash
GROQ_MINI_MODEL=llama-3.1-8b-instant
GROQ_MEDIUM_MODEL=llama-3.3-70b-versatile
GROQ_PRO_MODEL=llama-3.3-70b-versatile
GROK_MINI_MODEL=grok-4.5
GROK_MEDIUM_MODEL=grok-4.5
GROK_PRO_MODEL=grok-4.5
CLAUDE_MINI_MODEL=claude-3-5-haiku-20241022
CLAUDE_MEDIUM_MODEL=claude-3-5-sonnet-20241022
CLAUDE_PRO_MODEL=claude-3-opus-20240229
GPT_MINI_MODEL=gpt-4o-mini
GPT_MEDIUM_MODEL=gpt-4o
GPT_PRO_MODEL=gpt-4-turbo
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=

# Additional OCR and QR providers used directly by the private web container.
EASYOCR_API_URL=https://console.easyocr.org/api/ocr
EASYOCR_API_KEYS_JSON=[]
EASYOCR_API_KEY=
QRCODECAT_API_URL=
QRCODECAT_API_KEY=

# Self-hosted OCR limits. Printed scans use Tesseract/OCRmyPDF; handwriting uses Gemini first.
OCR_LANGUAGES=eng+urd
OCR_MAX_FILE_BYTES=26214400
OCR_MAX_PDF_PAGES=30
OCR_MAX_CONCURRENT_JOBS=1
OCR_JOB_TIMEOUT_SECONDS=180

# Oracle Email Delivery SMTP. Configure the same SMTP details in Supabase Auth.
SMTP_HOST=smtp.email.YOUR_OCI_REGION.oci.oraclecloud.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-oracle-smtp-username
SMTP_PASSWORD=your-oracle-smtp-password
EMAIL_FROM=ilm AI <noreply@your-domain.example>
CONTACT_EMAIL=ilmai.study1@gmail.com

# Payments remain optional until merchant approval. Android in-app purchases need Play Billing.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_PRICE_ID_ELITE_MONTHLY=
PADDLE_PRICE_ID_ELITE_ANNUAL=

# Optional Pakistan local checkout. Keep empty until PayPro merchant plan IDs
# and webhook secret are confirmed from your approved merchant account.
PAYPRO_CHECKOUT_URL=
PAYPRO_WEBHOOK_SECRET=
PAYPRO_PLAN_ID_PRO_MONTHLY=
PAYPRO_PLAN_ID_PRO_ANNUAL=
PAYPRO_PLAN_ID_ELITE_MONTHLY=
PAYPRO_PLAN_ID_ELITE_ANNUAL=

# Free web ads only. Do not assume website AdSense is valid inside the Play app.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=

# Fill after Play App Signing provides the SHA-256 certificate fingerprint.
ANDROID_PACKAGE_NAME=study.ilm.app
ANDROID_SHA256_CERT_FINGERPRINTS=
# Attach this hostname to the same Coolify web service; checkout is blocked there.
PLAY_CONSUMPTION_ONLY_HOSTS=app.your-domain.example
